# Copy to .env and fill in. Everything is optional: without keys the app runs in demo mode.
PUBLIC_SITE_URL=https://goodpush.app

# Web Push — generate with: npx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@goodpush.app

# Supabase (Project Settings → API). The service role key is SECRET.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Same project, public values — used for sign-in (Google / Apple / email code)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Protects /api/cron/send — any long random string (openssl rand -hex 32)
CRON_SECRET=

# Stripe Premium (Dashboard → Developers). Test keys first!
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PUBLIC_PREMIUM_PRICE=2,99 €

# Email marketing — Brevo (EU). Contacts → Lists → id ; Templates → double opt-in template id
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_WEBHOOK_SECRET=

# Monitoring (optional)
PUBLIC_SENTRY_DSN=

# Growth (optional)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
PUBLIC_AMAZON_TAG=
PUBLIC_INSTAGRAM_URL=https://instagram.com/goodpush.app
PUBLIC_TIKTOK_URL=https://tiktok.com/@goodpush.app
PUBLIC_CONTACT_EMAIL=hello@goodpush.app
